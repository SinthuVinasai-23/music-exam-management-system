# SQLite development portal: register an account, then use code 123456. No SMTP required.
VITE_AUTH_PREVIEW=true
# False selects the retained legacy SMTP adapter; it does not yet support the complete exam portal model.
# Copy this file to .env. Never share .env or put secrets in VITE_* variables.
APP_URL=http://127.0.0.1:5173
AUTH_PORT=5001
# Standard SMTP credentials supplied by your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# A sender address authorized by your provider, e.g. Music Exams <noreply@example.com>
SMTP_FROM=
# Optional: actual organization policy pages. Defaults use the existing FAQ route.
PRIVACY_URL=
TERMS_URL=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# Required for production: a random secret of 32+ characters and HTTPS APP_URL.
AUTH_SECRET=
# NODE_ENV=production

# Optional first-time Admin provisioning (default development credentials are in README).
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=

# Temporary default: allow subject selection without prior syllabus clearance.
# Set true to restore teacher/Admin syllabus clearance before selection.
REQUIRE_SYLLABUS_CLEARANCE=false

# Current development: new students are automatically approved.
# Future manual registration approval can be enabled without changing the data model.
REGISTRATION_APPROVAL_REQUIRED=false
