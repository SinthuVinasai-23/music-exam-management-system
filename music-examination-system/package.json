{
  "name": "music-examination-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test:browser": "node tests/portal-browser.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:auth": "node auth-server/server.mjs",
    "start": "node auth-server/server.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:auth:browser": "node tests/auth-browser.mjs",
    "test:teacher": "node --test tests/teacher.test.mjs",
    "test:teacher:browser": "node tests/teacher-browser.mjs",
    "test:supervisor": "node --test tests/supervisor.test.js tests/scanner.test.js",
    "test:supervisor:browser": "node tests/supervisor-browser.mjs && node tests/supervisor-additional.mjs",
    "test:student": "node tests/exam-applications-browser.mjs",
    "test:registration": "node --test tests/registration-parent.test.mjs",
    "test:registration:browser": "node tests/registration-parent-browser.mjs",
    "test:registration:design": "node tests/registration-design.mjs",
    "test:exam": "node --test tests/exam-applications.test.mjs",
    "test:exam:browser": "node tests/exam-applications-browser.mjs",
    "test:learning": "node --test tests/learning.test.mjs",
    "test:learning:browser": "node tests/learning-browser.mjs",
    "preview:logo": "node preview-logo.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.542.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "smtp-server": "^3.19.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
